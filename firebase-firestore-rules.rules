rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidTaskData(data) {
      return data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 500;
    }

    function isValidTask() {
      return isValidTaskData(request.resource.data);
    }

    function isValidTagOverrideData(data) {
      return data.tags is string && data.tags.size() <= 100;
    }

    function isValidTagOverride() {
      return isValidTagOverrideData(request.resource.data);
    }

    function isOwnLegacyDocument() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function writesOwnLegacyDocument() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function isFriendRecordFor(friendId) {
      return request.resource.data.uid == friendId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.preambleId is string
        && request.resource.data.preambleId.size() <= 40;
    }

    function hasIncomingInviteFrom(uid, friendId) {
      return exists(/databases/$(database)/documents/users/$(uid)/invites/$(friendId));
    }

    function isValidInviteFor(uid, inviteId) {
      return inviteId == request.auth.uid
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.targetUid == uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 100
        && request.resource.data.senderPreambleId is string
        && request.resource.data.senderPreambleId.size() <= 40;
    }

    function isCollabMember() {
      return signedIn()
        && resource.data.memberUids is list
        && request.auth.uid in resource.data.memberUids;
    }

    function isQueryableCollabMember() {
      return signedIn()
        && resource.data.memberUidMap is map
        && resource.data.memberUidMap[request.auth.uid] == true;
    }

    function hasValidMemberUidMap(data) {
      return data.memberUidMap is map
        && data.memberUidMap.keys().hasAll(data.memberUids)
        && data.memberUidMap.keys().hasOnly(data.memberUids)
        && data.memberUidMap[data.adminUid] == true;
    }

    function isValidMemberStatus(status) {
      return status in ['pending', 'accepted', 'completed', 'declined', 'left', 'removed'];
    }

    function isValidOwnMemberState() {
      let state = request.resource.data.memberStates[request.auth.uid];
      return state is map
        && state.uid == request.auth.uid
        && state.status is string
        && isValidMemberStatus(state.status)
        && state.isCompleted is bool;
    }

    function isValidCollaborativeDocument(taskId) {
      let d = request.resource.data;
      return d.schemaVersion == 2
        && d.taskId == taskId
        && d.adminUid is string
        && d.adminName is string
        && d.memberUids is list
        && d.memberUids.size() >= 1
        && d.memberUids.size() <= 51
        && d.assigneeUids is list
        && d.assigneeUids.size() <= 50
        && d.memberUids.hasAll(d.assigneeUids)
        && d.memberUids.hasAll([d.adminUid])
        && hasValidMemberUidMap(d)
        && d.memberStates is map
        && d.task is map
        && isValidTaskData(d.task);
    }

    function isCollaborativeAdminCreate(taskId) {
      return signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && isValidCollaborativeDocument(taskId);
    }

    function isCollaborativeAdminUpdate(taskId) {
      return signedIn()
        && resource.data.adminUid == request.auth.uid
        && request.resource.data.taskId == resource.data.taskId
        && isValidCollaborativeDocument(taskId);
    }

    function isValidReactionEmoji(emoji) {
      return emoji in ['👍', '🎉', '🔥', '👏', '❤️', '💪'];
    }

    function isValidOwnReaction() {
      let r = request.resource.data.reactions[request.auth.uid];
      return r is map && r.emoji is string && isValidReactionEmoji(r.emoji);
    }

    function updatesOwnReactionOnly() {
      return isCollabMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'updatedAt'])
        && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
        && (
            // remove: own key absent after the write (Req 2.3, 2.4)
            !(request.auth.uid in request.resource.data.reactions)
            // add/change: own key present and a valid 6-set emoji (Req 1.2, 1.3, 2.2)
            || isValidOwnReaction()
           );
    }

    function isValidPointsAward() {
      let before = resource.data.totalPoints;
      let after  = request.resource.data.totalPoints;
      return after == before + 10
        && after >= before
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['totalPoints', 'weeklyPoints', 'awardedTasks', 'updatedAt']);
    }

    function updatesOwnMemberStatusOnly() {
      return isCollabMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberStates', 'updatedAt'])
        && request.resource.data.memberStates.diff(resource.data.memberStates).affectedKeys().hasOnly([request.auth.uid])
        && isValidOwnMemberState();
    }

    function updatesOwnSubtaskStateOnly() {
      return isCollabMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['task', 'memberStates', 'updatedAt'])
        && request.resource.data.task.diff(resource.data.task).affectedKeys().hasOnly(['subtasksJson', 'updatedTimestamp'])
        && request.resource.data.memberStates.diff(resource.data.memberStates).affectedKeys().hasOnly([request.auth.uid])
        && isValidOwnMemberState();
    }

    function removesSelfFromCollaborativeTaskOnly() {
      return isCollabMember()
        && resource.data.adminUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'assigneeUids', 'memberUidMap', 'memberStates', 'updatedAt'])
        && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
        && request.resource.data.assigneeUids == resource.data.assigneeUids.removeAll([request.auth.uid])
        && hasValidMemberUidMap(request.resource.data)
        && request.resource.data.memberStates.diff(resource.data.memberStates).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.memberStates[request.auth.uid].status == 'left'
        && isValidOwnMemberState();
    }

    // ---- Shared Circle helpers (canonical /circles/{circleId} document). ----
    function circleIsMember() {
      return signedIn()
        && resource.data.memberUids is list
        && request.auth.uid in resource.data.memberUids;
    }

    function circleIsQueryableMember() {
      return signedIn()
        && resource.data.memberUidMap is map
        && resource.data.memberUidMap[request.auth.uid] == true;
    }

    function circleHasValidMemberUidMap(data) {
      return data.memberUidMap is map
        && data.memberUidMap.keys().hasAll(data.memberUids)
        && data.memberUidMap.keys().hasOnly(data.memberUids)
        && data.memberUidMap[data.adminUid] == true;
    }

    function isValidCircleMemberStatus(status) {
      return status in ['active', 'left', 'removed'];
    }

    function isValidCircleDocument(circleId) {
      let d = request.resource.data;
      return d.circleId == circleId
        && d.adminUid is string
        && d.name is string
        && d.name.size() >= 1
        && d.memberUids is list
        && d.memberUids.size() >= 1
        && d.memberUids.size() <= 50
        && d.memberUids.hasAll([d.adminUid])
        && circleHasValidMemberUidMap(d)
        && d.memberStates is map;
    }

    function isCircleAdminCreate(circleId) {
      return signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && isValidCircleDocument(circleId);
    }

    function isCircleAdminUpdate(circleId) {
      return signedIn()
        && resource.data.adminUid == request.auth.uid
        && request.resource.data.adminUid == resource.data.adminUid
        && request.resource.data.circleId == resource.data.circleId
        && isValidCircleDocument(circleId);
    }

    // Non-admin self-removal: own-slice idiom (Req 13.5), parallels
    // removesSelfFromCollaborativeTaskOnly.
    function removesSelfFromCircleOnly() {
      return circleIsMember()
        && resource.data.adminUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'memberUidMap', 'memberStates', 'updatedAt'])
        && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
        && circleHasValidMemberUidMap(request.resource.data)
        && request.resource.data.memberStates.diff(resource.data.memberStates).affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.memberStates[request.auth.uid].status == 'left';
    }

    // ---- Shared Circle task helpers (denormalized memberUidMap on the task
    // itself — no parent get() for membership reads). ----
    function circleTaskIsMember() {
      return signedIn()
        && resource.data.memberUidMap is map
        && resource.data.memberUidMap[request.auth.uid] == true;
    }

    function circleTaskIncomingIsMember() {
      return signedIn()
        && request.resource.data.memberUidMap is map
        && request.resource.data.memberUidMap[request.auth.uid] == true;
    }

    function isValidCircleTaskCreate() {
      let d = request.resource.data;
      return d.circleId is string
        && d.authorUid == request.auth.uid
        && d.title is string
        && d.title.size() >= 1
        && d.title.size() <= 500
        && d.isCompleted == false
        && circleTaskIncomingIsMember();
    }

    // ANY member may write ONLY the shared-completion fields (Req 14.4) —
    // diff-based, parallels updatesOwnMemberStatusOnly / updatesOwnReactionOnly.
    function updatesOnlyCompletionFields() {
      return circleTaskIsMember()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isCompleted', 'completedBy', 'completedAt', 'updatedAt'])
        && request.resource.data.isCompleted is bool
        && request.resource.data.circleId == resource.data.circleId
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.title == resource.data.title
        && request.resource.data.memberUidMap == resource.data.memberUidMap;
    }

    // Title edit / delete: author or circle admin only (Req 14.5, 14.6).
    function isCircleTaskAuthor() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }

    function isCircleAdminOf(circleId) {
      return signedIn()
        && get(/databases/$(database)/documents/circles/$(circleId)).data.adminUid == request.auth.uid;
    }

    function authorOrAdminEdit() {
      return circleTaskIsMember()
        && (isCircleTaskAuthor() || isCircleAdminOf(resource.data.circleId))
        && request.resource.data.circleId == resource.data.circleId
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.memberUidMap == resource.data.memberUidMap;
    }

    // Public directory for discovering users by Preamble ID.
    match /preambleIds/{preambleId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // User profile and private subcollections.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /friends/{friendId} {
        allow read: if isOwner(uid);
        allow create: if signedIn() && (
          (
            isOwner(uid)
            && isFriendRecordFor(friendId)
            && hasIncomingInviteFrom(uid, friendId)
          )
          || (
            friendId == request.auth.uid
            && isFriendRecordFor(friendId)
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(uid))
          )
        );
        allow update: if isOwner(uid)
          && resource.data.uid == friendId
          && isFriendRecordFor(friendId);
        allow delete: if isOwner(uid) || (signedIn() && friendId == request.auth.uid);
      }

      match /invites/{inviteId} {
        // The owner reads all their incoming invites. A sender may read ONLY the
        // single outgoing invite doc keyed by their own uid, so the duplicate-pending
        // guard in sendInvite works without exposing anyone else's invites (Req 1.7, 17).
        allow get: if isOwner(uid) || (signedIn() && inviteId == request.auth.uid);
        allow list: if isOwner(uid);
        allow create: if signedIn() && isValidInviteFor(uid, inviteId);
        allow update: if false;
        allow delete: if isOwner(uid) || (signedIn() && inviteId == request.auth.uid);
      }

      // Outgoing-invite mirror (social-hub-redesign Req 4.1): the sender's private
      // copy of each Friend_Request they have sent, keyed by the recipient's uid at
      // /users/{senderUid}/outgoingInvites/{targetUid}. It is owner-private — only the
      // sender reads, creates (in the same batch as the recipient's incoming invite),
      // and deletes (withdraw) it; it is never updated in place and is never exposed to
      // anyone else.
      match /outgoingInvites/{targetId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // Deny the buggy per-user collaborative task copy path. Shared tasks now live
      // only at /collaborativeTasks/{taskId}.
      match /collaborativeTasks/{taskId} {
        allow read, write: if false;
      }
    }

    // Legacy root task mirror used by the current Play Store app.
    // Tightened: users can only read/delete docs whose stored uid is their own.
    match /tasks/{taskId} {
      allow read, delete: if isOwnLegacyDocument();
      allow create, update: if writesOwnLegacyDocument() && isValidTask();
    }

    match /tagOverrides/{overrideId} {
      allow read, delete: if isOwnLegacyDocument();
      allow create, update: if writesOwnLegacyDocument() && isValidTagOverride();
    }

    // Canonical collaborative tasks.
    match /collaborativeTasks/{taskId} {
      allow get: if isCollabMember();
      allow list: if isQueryableCollabMember();
      allow create: if isCollaborativeAdminCreate(taskId);
      allow update: if isCollaborativeAdminUpdate(taskId)
        || updatesOwnMemberStatusOnly()
        || updatesOwnSubtaskStateOnly()
        || updatesOwnReactionOnly()
        || removesSelfFromCollaborativeTaskOnly();
      allow delete: if signedIn() && resource.data.adminUid == request.auth.uid;
    }

    // Canonical shared circles. Membership-gated reads, admin-gated metadata
    // writes, and the non-admin self-removal own-slice idiom (Req 13).
    match /circles/{circleId} {
      allow get: if circleIsMember();
      allow list: if circleIsQueryableMember();
      allow create: if isCircleAdminCreate(circleId);
      allow update: if isCircleAdminUpdate(circleId)
        || removesSelfFromCircleOnly();
      allow delete: if signedIn() && resource.data.adminUid == request.auth.uid;
    }

    // Canonical shared Circle tasks (top-level, denormalized memberUidMap).
    // Member-gated reads, member create, any-member completion writes, and
    // author/admin-gated title edit and delete (Req 14).
    match /circleTasks/{taskId} {
      allow get: if circleTaskIsMember();
      allow list: if circleTaskIsMember();
      allow create: if isValidCircleTaskCreate();
      allow update: if updatesOnlyCompletionFields()
        || authorOrAdminEdit();
      allow delete: if circleTaskIsMember()
        && (isCircleTaskAuthor() || isCircleAdminOf(resource.data.circleId));
    }

    // Friends leaderboard — self-owned, friend-readable productivity score.
    match /leaderboard/{uid} {
      // Owner reads own score; a friend may read iff they are in the owner's friends subcollection.
      allow read: if isOwner(uid)
        || (signedIn() && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
      // First award creates the doc at exactly the Completion_Award.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.totalPoints == 10;
      // Subsequent awards are owner-only, +10, monotonic.
      allow update: if isOwner(uid) && isValidPointsAward();
      allow delete: if false;
    }

    // Nudges — written/read only by the sendNudge Cloud Function (Admin SDK).
    match /nudges/{nudgeId} {
      allow read, write: if false;
    }

    // Notification idempotency ledger — written/read only by the notification
    // Cloud Functions (Admin SDK) to dedupe retried event deliveries.
    // No client may read or forge entries.
    // Recommended: configure a Firestore TTL policy on the `at` field
    // (e.g. 7 days) to keep this collection bounded.
    match /notificationEvents/{doc} {
      allow read, write: if false;
    }

    // Broadcasts — authenticated users can read admin broadcasts.
    match /broadcasts/{broadcastId} {
      allow read: if signedIn();
    }

    // Problem reports — users can track their own reports.
    // Creation/status changes happen through Cloud Functions/Admin SDK.
    match /problemReports/{reportId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Admin tasks — users can only read and update their own status flags.
    match /users/{uid}/assignedTasks/{taskId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasAll(['completed', 'dismissed'])
        && request.resource.data.keys().size() == 2;
    }

    // AI chat messages — users can read/write their own conversations.
    match /users/{uid}/ai_chat/{conversationId} {
      allow read, write: if isOwner(uid);

      match /messages/{messageId} {
        allow read, write: if isOwner(uid);
      }
    }

    // AI memory — users can read/write their own long-term memory.
    match /users/{uid}/ai_memory/{memoryId} {
      allow read, write: if isOwner(uid);
    }

    // AI credits — read-only for clients; writes happen through Admin SDK.
    match /users/{uid}/ai_credits/{doc} {
      allow read: if isOwner(uid);
    }

    // Referral attribution. The referred user may create exactly one PENDING
    // attribution naming someone else; only the Admin SDK may move it to
    // "rewarded"/"rejected" or grant credits. (Req 2.2, 2.6, 3.4, 3.5, 4.1)
    match /referrals/{referredUid} {
      // Owner reads their own attribution; referrer may read the doc that names them.
      allow read: if isOwner(referredUid)
        || (signedIn() && resource.data.referrerUid == request.auth.uid);

      // Create: only the referred user, only state "pending", never self-referral,
      // and the doc must be keyed by the creator's own uid.
      allow create: if isOwner(referredUid)
        && request.resource.data.referredUid == request.auth.uid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.state == 'pending';

      // Clients can never update or delete (no flipping to "rewarded",
      // no changing referrerUid). All state changes go through the Admin SDK.
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
