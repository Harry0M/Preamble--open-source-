rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Simple validation that won't fail
    function isValidTask() {
      let d = request.resource.data;
      // Title must exist and be reasonable length
      return d.title is string
        && d.title.size() >= 1
        && d.title.size() <= 500;
    }

    function isValidTagOverride() {
      let d = request.resource.data;
      return d.tags is string && d.tags.size() <= 100;
    }

    // User profile access - CRITICAL for app functionality
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // OLD PATH STRUCTURE - what the app actually uses
    match /tasks/{taskId} {
      allow read, delete: if request.auth != null; // Authenticated users can read
      allow create, update: if isOwner(request.resource.data.uid) && isValidTask();
    }

    match /tagOverrides/{overrideId} {
      allow read, delete: if request.auth != null; // Authenticated users can read
      allow create, update: if isOwner(request.resource.data.uid) && isValidTagOverride();
    }

    // Admin tasks - users can only read their assigned tasks
    match /users/{uid}/assignedTasks/{taskId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && 
        (request.resource.data.keys().hasAll(['completed', 'dismissed']) &&
         request.resource.data.keys().size() == 2);
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
