rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can only access their own task media
    match /users/{uid}/tasks/{taskId}/media/{file} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024  // 50 MB max
        && request.resource.contentType.matches('image/(jpeg|png|webp)|video/(mp4|quicktime|webm)');
    }
  }
}